{
  "name": "@robiteame/dsh-client-ui-session-tree",
  "description": "Session-tree WebUI panel: a native tab in the Harness 0.2 right Sidebar, with an additive overlay fallback for older stock builds",
  "version": "0.7.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robiteame/dsh-session-tree-extension.git",
    "directory": "packages/client/ui-session-tree"
  },
  "bugs": {
    "url": "https://github.com/robiteame/dsh-session-tree-extension/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node ../../../scripts/build.mjs ui",
    "watch": "node ../../../scripts/build.mjs ui"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.1-rc.2"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  }
}
