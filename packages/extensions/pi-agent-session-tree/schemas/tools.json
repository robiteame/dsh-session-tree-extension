{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "create",
        "append",
        "list",
        "branches",
        "tree",
        "jump",
        "context",
        "branch",
        "branch.summary",
        "snapshot.save",
        "snapshot.load",
        "sessions"
      ]
    },
    "sessionId": { "type": "string" },
    "nodeId": { "type": ["string", "null"] },
    "branch": { "type": "string" },
    "summary": { "type": "string" },
    "message": {
      "type": "object",
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string" },
        "name": { "type": "string" },
        "toolCallId": { "type": "string" }
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "snapshot": { "type": "object" }
  },
  "required": ["operation"],
  "additionalProperties": false
}
