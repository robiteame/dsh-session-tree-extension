{
  "name": "dsh-session-tree-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Development workspace for the dsh-session-tree plugin packages (not published)",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --project tsconfig.check.host.json && tsc --project tsconfig.check.client.json",
    "verify": "pnpm build && pnpm typecheck && node scripts/verify-bundle.mjs --pack && pnpm test",
    "pack:all": "pnpm build && node scripts/verify-bundle.mjs && pnpm --filter @robiteame/dsh-pi-agent-session-tree pack && pnpm --filter @robiteame/dsh-tool-session-tree pack && pnpm --filter @robiteame/dsh-client-ui-session-tree pack && pnpm --filter @robiteame/dsh-session-tree pack"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-remotes": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-attachment": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-locale": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-commands": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-scope": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-projection": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-system-prompt": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-tools": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-typert-protocol": "0.1.2-alpha.3",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.0",
    "jsdom": "29.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
